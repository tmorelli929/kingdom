# Copy to .env.local for local development. In production, set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# Postgres connection string (Vercel fills this in when you add Neon from the Storage tab)
DATABASE_URL=postgres://postgres@localhost:5433/kingdom

# Public URL of the app, no trailing slash
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated list of Google accounts allowed to sign in
ALLOWED_EMAILS=you@gmail.com

# Anthropic API key for the coach (console.anthropic.com → API keys). Set a monthly spend limit.
ANTHROPIC_API_KEY=

# Optional: 32 random bytes, base64, used to encrypt Google tokens at rest (e.g. `openssl rand -base64 32`).
# If unset, a key is derived from AUTH_GOOGLE_SECRET. Changing either means reconnecting Calendar.
TOKEN_ENCRYPTION_KEY=

# Local development only: lets you sign in without Google as the first ALLOWED_EMAILS address.
# Ignored in production builds.
DEV_LOGIN=0
